# 한국관광공사 국문 관광정보 서비스(GW) 인증키 (Decoding 키)
# https://www.data.go.kr 에서 발급받은 서비스키를 입력하세요.
# 또는 앱 우측 상단 [환경 설정] 모달에서 입력할 수 있습니다.
KTO_SERVICE_KEY=

# (선택) API 베이스 URL - 기본값 사용 시 비워두세요.
# KTO_API_BASE=https://apis.data.go.kr/B551011/KorService2

# ---- AI 여행자 가이드 (HuggingFace + Tavily) ----
# HuggingFace Inference API 토큰 (필수: LLM 생성)
HUGGINGFACE_API_KEY=
# 대표 모델 예: Qwen/Qwen2.5-7B-Instruct , meta-llama/Meta-Llama-3.1-8B-Instruct
# 앱 [환경 설정]에서 목록 선택 또는 (직접 입력)으로 HF 모델 ID 붙여넣기
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
# 0~1 권장
HUGGINGFACE_TEMPERATURE=0.4

# Tavily 검색 API (선택: 지역 웹 컨텍스트 보강)
TAVILY_API_KEY=
